    <field name="metodo" class="java.lang.String"/>
    <field name="concepto" class="java.lang.String"/>
    <title><band height="65"><textField><reportElement x="0" y="0" width="555" height="28"/><textElement><font fontName="SansSerif" size="18" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField><textField><reportElement x="0" y="35" width="555" height="18"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{FILTER_TEXT}]]></textFieldExpression></textField></band></title>
    <columnHeader><band height="28"><staticText><reportElement x="0" y="0" width="75" height="22" backcolor="#E8EDF2" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement x="75" y="0" width="175" height="22" backcolor="#E8EDF2" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Miembro]]></text></staticText><staticText><reportElement x="250" y="0" width="80" height="22" backcolor="#E8EDF2" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Monto]]></text></staticText><staticText><reportElement x="330" y="0" width="100" height="22" backcolor="#E8EDF2" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Método]]></text></staticText><staticText><reportElement x="430" y="0" width="125" height="22" backcolor="#E8EDF2" mode="Opaque"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Concepto]]></text></staticText></band></columnHeader>
    <detail><band height="22"><textField><reportElement x="0" y="0" width="75" height="20"/><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="75" y="0" width="175" height="20"/><textFieldExpression><![CDATA[$F{miembro}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="250" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression></textField><textField><reportElement x="330" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{metodo}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="430" y="0" width="125" height="20"/><textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression></textField></band></detail>
